{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/modernization/automated-cobol-analysis.schema.json",
    "title": "Automated COBOL candidate evidence",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "artifactType",
        "applicationId",
        "sourceRevision",
        "analyzer",
        "coverage",
        "limitations",
        "files"
    ],
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "artifactType": {
            "const": "automated-cobol-analysis"
        },
        "applicationId": {
            "type": "string",
            "pattern": "^APP-[A-Z0-9-]+$"
        },
        "sourceRevision": {
            "type": "string",
            "minLength": 1
        },
        "analyzer": {
            "type": "object",
            "required": [
                "name",
                "version",
                "capability"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "capability": {
                    "const": "candidate-evidence-only"
                }
            }
        },
        "coverage": {
            "type": "object",
            "required": [
                "attempted",
                "succeeded",
                "partial",
                "failed",
                "warningCount",
                "errorCount"
            ],
            "properties": {
                "attempted": {
                    "type": "integer",
                    "minimum": 1
                },
                "succeeded": {
                    "type": "integer",
                    "minimum": 0
                },
                "partial": {
                    "type": "integer",
                    "minimum": 0
                },
                "failed": {
                    "type": "integer",
                    "minimum": 0
                },
                "warningCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "errorCount": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "files": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object"
            }
        }
    }
}